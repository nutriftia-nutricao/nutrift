# Nutrift — variáveis de ambiente
# Copie este arquivo para .env e preencha com suas chaves.
# Nunca commite o arquivo .env (ele já está no .gitignore).

# --- Supabase ---
# Obtenha em: https://supabase.com/dashboard → seu projeto → Project Settings → API
# URL do projeto e "anon" public key (segura para uso no app).
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: service_role key (só para scripts no servidor, ex: import TACO).
# Nunca use no app mobile/web — apenas em scripts locais.
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- APIs opcionais ---
# Google Gemini: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_KEY=sua-chave-gemini-api
# OpenAI (agente): https://platform.openai.com/api-keys
# EXPO_PUBLIC_OPENAI_API_KEY=
# EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
