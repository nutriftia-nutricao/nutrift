# Supabase — crie um projeto em https://supabase.com e preencha abaixo.
# Copie este arquivo para .env e ajuste os valores.

EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Google Gemini API — obtenha em https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_KEY=sua-chave-gemini-api
